# NOMBRE DEL ARCHIVO: Dockerfile.build
# ------------------------------------

# 1. Etapa temporal para robar el binario de Dragonfly
FROM docker.dragonflydb.io/dragonflydb/dragonfly:latest as dragonfly-source

# 2. Imagen final ligera
FROM node:18-slim

# Instalar utilidades básicas
RUN apt-get update && apt-get install -y procps ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- AQUÍ INSTALAMOS DRAGONFLY ---
# Copiamos el motor desde la imagen oficial
COPY --from=dragonfly-source /usr/local/bin/dragonfly /usr/local/bin/dragonfly

# Instalamos dependencias de Node
COPY package*.json ./
RUN npm ci --omit=dev

# Copiamos el código
COPY . .
COPY start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 3000
CMD ["/start.sh"]